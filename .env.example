# Modelo de configuracao. Copie para .env (cp .env.example .env) e ajuste se necessario.
# O arquivo .env real NAO deve ser commitado (ja esta no .gitignore).
# As senhas padrao abaixo sao apenas para desenvolvimento local; nao use em producao.

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=fleetdb
POSTGRES_HOST=db
POSTGRES_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=3000
CONNECTION_STRING=Host=db;Port=5432;Database=fleetdb;Username=admin;Password=admin123

# Mapa do painel (ADR-0016). Por padrao o NAVEGADOR de quem usa o painel busca os
# tiles em tiles.openfreemap.org, que recebe o IP e a regiao vista. Para nao enviar
# nada a terceiros, deixe MAP_TILEJSON_URL e MAP_CSP_ORIGINS vazias (os veiculos
# ficam sobre fundo liso). Nao use aspas nem ":-" ao copiar para o compose.
MAP_TILEJSON_URL=https://tiles.openfreemap.org/planet
MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
# Estilo completo proprio (outro esquema que nao OpenMapTiles); substitui as duas acima.
MAP_STYLE_URL=
# Origens liberadas em connect-src, separadas por espaco. Vazia se o fundo estiver desligado.
MAP_CSP_ORIGINS=https://tiles.openfreemap.org
# Credito do provedor, pares texto|link separados por ";". O do OpenStreetMap e fixo no codigo.
MAP_CREDIT=OpenFreeMap|https://openfreemap.org;© OpenMapTiles|https://www.openmaptiles.org/
