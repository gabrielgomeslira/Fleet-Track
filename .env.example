# Modelo de configuracao. Copie para .env (cp .env.example .env) e ajuste se necessario.
# O arquivo .env real NAO deve ser commitado (ja esta no .gitignore).
# As senhas padrao abaixo sao apenas para desenvolvimento local; nao use em producao.

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=fleetdb
POSTGRES_HOST=db
POSTGRES_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=3000
CONNECTION_STRING=Host=db;Port=5432;Database=fleetdb;Username=admin;Password=admin123
